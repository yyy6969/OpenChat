# HTTP 服务监听地址
# 本机联调用 127.0.0.1；部署到服务器需要被其他机器访问时改成 0.0.0.0
HOST=127.0.0.1
PORT=50051

# 验证码有效期，单位秒
CODE_TTL_SECONDS=300

# 1 = mock 模式，不真正发邮件，只在控制台打印验证码
# 0 = 使用下面的 SMTP 配置真实发送邮件
MOCK_EMAIL=1

# 163 邮箱 SMTP 配置
# SMTP_PASS 填邮箱设置里生成的授权码，不是登录密码
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your_email@163.com
SMTP_PASS=your_smtp_auth_code
